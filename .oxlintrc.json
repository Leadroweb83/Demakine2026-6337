{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "depth": 5,
        "ignoreElements": [
          "audio",
          "canvas",
          "embed",
          "input",
          "textarea",
          "tr",
          "video",
          "option"
        ]
      }
    ],
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "depth": 4
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "dist-electron/**",
    ".expo/**",
    "packages/web/public/runable.js"
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  }
}
