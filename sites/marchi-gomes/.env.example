# URL publica do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://www.marchigomes.adv.br
# Webhook que recebe os leads do formulario (CRM, Make, n8n, planilha)
LEAD_WEBHOOK_URL=
# Google Tag Manager (GA4 e pixels entram por ele), ex.: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity (mapas de calor e gravacoes)
NEXT_PUBLIC_CLARITY_ID=
# Link do Calendly ou do agendamento do Google Agenda
NEXT_PUBLIC_SCHEDULING_URL=
# Verificacao de propriedade (codigos gerados no Search Console e no Bing Webmaster)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
# E-mails automaticos via Resend: confirmacao ao lead e aviso ao escritorio
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
# Cloudflare Turnstile: protecao invisivel contra spam no formulario
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sentry: aviso de erros em producao
NEXT_PUBLIC_SENTRY_DSN=
# E-mail pelo SMTP da propria hospedagem (Zoe/cPanel): recomendado, sem servico externo.
# Crie uma caixa so para o site (ex.: site@marchigomes.adv.br) e use os dados dela.
SMTP_HOST=mail.marchigomes.adv.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Opcional: remetente exibido (padrao = SMTP_USER)
SMTP_FROM=
# Quem recebe os contatos (padrao = contato@marchigomes.adv.br)
LEAD_NOTIFY_EMAIL=
