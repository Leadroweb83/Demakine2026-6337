---
interface Crumb { name: string; href: string }
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: Crumb[]; image?: string }
const { eyebrow, title, lead, crumbs = [], image = '/img/tema/terra-noite.webp' } = Astro.props;
---
<section class="hero hero--page">
  <span class="hero__photo" style={`background-image:url('${image}')`} aria-hidden="true"></span>
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs rise" aria-label="Você está aqui">
        <ol>
          <li><a href="/">Início</a></li>
          {crumbs.map((c, i) => (
            <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <span class="eyebrow rise" style="--d:1">{eyebrow}</span>}
    <h1 class="rise" style="--d:2">{title}</h1>
    {lead && <p class="lead rise" style="--d:3">{lead}</p>}
    <div class="rise" style="--d:4"><slot /></div>
  </div>
</section>
