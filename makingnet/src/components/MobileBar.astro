---
// Barra fixa no celular: WhatsApp e orçamento sempre à mão. Some durante a introdução em vídeo.
import { whatsappLink } from '../data/site';
interface Props { path: string }
const { path } = Astro.props;
const showQuote = path !== '/orcamento/';
---
<div class="mbar" role="navigation" aria-label="Contato rápido">
  <a class="mbar__wa" href={whatsappLink()} target="_blank" rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.1L2 22l5.05-1.6A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.13 15.06l-.3-.18-2.99.95.97-2.9-.2-.31A8.1 8.1 0 0 1 12.04 3.8Zm-3.1 3.9c-.2 0-.5.07-.76.36-.26.29-1 1-1 2.4 0 1.42 1.03 2.8 1.18 2.99.14.2 2 3.18 4.93 4.33 2.43.96 2.93.77 3.46.72.53-.05 1.7-.7 1.94-1.37.24-.67.24-1.25.17-1.37-.07-.12-.26-.2-.55-.34-.29-.14-1.7-.84-1.97-.94-.26-.1-.45-.14-.65.15-.19.29-.74.93-.9 1.12-.17.2-.34.22-.63.08-.29-.15-1.22-.45-2.32-1.44a8.7 8.7 0 0 1-1.6-2c-.17-.29-.02-.44.12-.59.13-.13.29-.34.43-.5.15-.18.2-.3.3-.5.09-.19.04-.36-.03-.5-.07-.15-.64-1.58-.9-2.16-.22-.52-.46-.53-.66-.54h-.56Z"></path></svg>
    WhatsApp
  </a>
  {showQuote && <a class="mbar__q" href="/orcamento/">Pedir orçamento</a>}
</div>
<style is:global>
  .mbar {
    display: none;
  }
  @media (max-width: 860px) {
    .mbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 45;
      display: flex;
      gap: 10px;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: rgba(5, 9, 12, 0.94);
      backdrop-filter: blur(10px);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .mbar a {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
    }
    .mbar__wa {
      background: var(--mk-wa);
      color: #fff;
    }
    .mbar__q {
      background: var(--mk-cyan);
      color: #04202b;
    }
    .intro-on .mbar {
      display: none;
    }
    body {
      padding-bottom: 72px;
    }
    .wa-float {
      display: none;
    }
  }
</style>
