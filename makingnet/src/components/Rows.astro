---
// Lista editorial numerada: substitui grades de cartões nas páginas internas.
interface Item { title: string; text?: string; items?: string[]; href?: string; cta?: string }
interface Props { items: Item[]; as?: 'h2' | 'h3' }
const { items, as: Tag = 'h2' } = Astro.props;
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<ol class="rows">
  {items.map((it, i) => (
    <li data-reveal>
      {it.href ? (
        <a class="row row--link" href={it.href}>
          <span class="row__n">{n(i)}</span>
          <Tag class="row__t">{it.title}</Tag>
          <div class="row__b">{it.text && <p>{it.text}</p>}</div>
          <span class="row__go" aria-hidden="true">→</span>
        </a>
      ) : (
        <div class="row">
          <span class="row__n">{n(i)}</span>
          <Tag class="row__t">{it.title}</Tag>
          <div class="row__b">
            {it.text && <p>{it.text}</p>}
            {it.items && <ul class="checks">{it.items.map((x) => <li>{x}</li>)}</ul>}
          </div>
        </div>
      )}
    </li>
  ))}
</ol>
