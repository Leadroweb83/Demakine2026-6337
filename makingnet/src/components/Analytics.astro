---
// Google Analytics 4, só depois do aceite de cookies. Defina PUBLIC_GA_ID (ex.: G-XXXXXXXXXX) para ligar.
// Sem a variável, nada é carregado. Modo de consentimento: começa negado e só passa a concedido com o aceite.
const id = import.meta.env.PUBLIC_GA_ID;
---
{id && (
  <script is:inline define:vars={{ id }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    var loaded = false;
    function grant() {
      if (loaded) return;
      loaded = true;
      gtag('consent', 'update', { analytics_storage: 'granted' });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', id);
    }
    if (window.mkConsent === 'all') grant();
    window.addEventListener('mk:consent', function (e) { if (e.detail === 'all') grant(); });
  </script>
)}
