---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import Rows from '../../components/Rows.astro';
import { areas, sistemas } from '../../data/servicos';
const crumbs = [{ name: 'Serviços', href: '/nossos-servicos/' }];
---
<Base title="Serviços de Marketing Digital, TI e Sistemas | Making" description="Conheça os serviços da Making: marketing digital, hardware e infraestrutura de TI e o sistema de gestão Velosys. Soluções personalizadas desde 2003." path="/nossos-servicos/" crumbs={crumbs}>
  <PageHero eyebrow="Serviços" title="Três frentes, um parceiro" crumbs={crumbs} lead="Especialistas em marketing digital e em tecnologia da informação, além de um sistema próprio para gerenciar o controle e o faturamento da sua empresa." />
  {areas.map((area) => (
    <section class="section">
      <div class="wrap">
        <span class="eyebrow" data-reveal>{area.servicos.length} serviços</span>
        <h2 data-reveal><a href={`/nossos-servicos/${area.slug}/`} style="color:inherit;text-decoration:none">{area.name}</a></h2>
        <p class="lead" data-reveal>{area.resumo}</p>
        <Rows as="h3" items={area.servicos.map((s) => ({ title: s.name, text: s.resumo, href: `/nossos-servicos/${area.slug}/${s.slug}/` }))} />
      </div>
    </section>
  ))}
  <section class="section">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Sistema próprio</span>
      <h2 data-reveal>{sistemas.name}</h2>
      <Rows as="h3" items={[{ title: 'Velosys', text: sistemas.resumo, href: '/nossos-servicos/sistemas/' }]} />
    </div>
  </section>
  <Cta />
</Base>
