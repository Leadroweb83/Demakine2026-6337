---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Cta from '../../../components/Cta.astro';
import Rows from '../../../components/Rows.astro';
import Marquee from '../../../components/Marquee.astro';
import { areas } from '../../../data/servicos';
import { site } from '../../../data/site';
export function getStaticPaths() {
  return areas.map((area) => ({ params: { area: area.slug }, props: { area } }));
}
const { area } = Astro.props;
const path = `/nossos-servicos/${area.slug}/`;
const isMarketing = area.slug === 'marketing-digital';
const crumbs = [{ name: 'Serviços', href: '/nossos-servicos/' }, { name: area.name, href: path }];
const schema = [{
  '@type': 'ItemList',
  name: `Serviços de ${area.name}`,
  itemListElement: area.servicos.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${site.url}${path}${s.slug}/` })),
}];
---
<Base title={area.seoTitle} description={area.seoDescription} path={path} crumbs={crumbs} schema={schema}>
  <PageHero eyebrow={area.name} title={area.h1} crumbs={crumbs} image={isMarketing ? '/img/tema/terra-noite.webp' : '/img/tema/servidores.webp'}>
    <div class="actions"><a class="btn btn--primary" href="/orcamento/">Pedir orçamento</a></div>
  </PageHero>
  <section class="section">
    <div class="wrap">
      <p class="intro" data-reveal>{area.intro[0]}</p>
      {area.intro.length > 1 && <div class="intro-more" data-reveal>{area.intro.slice(1).map((p) => <p>{p}</p>)}</div>}
      <h2 data-reveal style="margin-top:clamp(56px,8vw,112px)">Serviços de {area.name.toLowerCase()}</h2>
      <Rows as="h3" items={area.servicos.map((s) => ({ title: s.name, text: s.resumo, href: `${path}${s.slug}/` }))} />
    </div>
  </section>
  {isMarketing && (
    <section class="section" style="padding-top:0">
      <div class="wrap" style="margin-bottom:28px">
        <span class="eyebrow" data-reveal>Portfólio</span>
        <h2 data-reveal>Trabalhos recentes</h2>
      </div>
      <Marquee />
      <div class="wrap"><div class="actions" data-reveal><a class="btn btn--ghost" href="/nossos-servicos/marketing-digital/portfolio/">Ver portfólio completo</a></div></div>
    </section>
  )}
  <Cta />
</Base>
