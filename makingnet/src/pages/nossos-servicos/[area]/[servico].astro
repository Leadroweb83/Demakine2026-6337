---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Cta from '../../../components/Cta.astro';
import Faq from '../../../components/Faq.astro';
import Rows from '../../../components/Rows.astro';
import Marquee from '../../../components/Marquee.astro';
import { areas } from '../../../data/servicos';
import { site } from '../../../data/site';
export function getStaticPaths() {
  return areas.flatMap((area) => area.servicos.map((servico) => ({ params: { area: area.slug, servico: servico.slug }, props: { area, servico } })));
}
const { area, servico } = Astro.props;
const areaPath = `/nossos-servicos/${area.slug}/`;
const path = `${areaPath}${servico.slug}/`;
const isMarketing = area.slug === 'marketing-digital';
const crumbs = [
  { name: 'Serviços', href: '/nossos-servicos/' },
  { name: area.name, href: areaPath },
  { name: servico.name, href: path },
];
const schema = [
  {
    '@type': 'Service',
    '@id': `${site.url}${path}#service`,
    name: servico.name,
    serviceType: servico.name,
    category: area.name,
    description: servico.seoDescription,
    url: `${site.url}${path}`,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'Brasil' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: servico.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const outros = area.servicos.filter((s) => s.slug !== servico.slug);
const [abertura, ...resto] = servico.intro;
---
<Base title={servico.seoTitle} description={servico.seoDescription} path={path} crumbs={crumbs} schema={schema}>
  <PageHero eyebrow={area.name} title={servico.h1} crumbs={crumbs} image={isMarketing ? '/img/tema/terra-noite.webp' : '/img/tema/servidores.webp'}>
    <div class="actions"><a class="btn btn--primary" href="/orcamento/">{servico.cta}</a></div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <p class="intro" data-reveal>{abertura}</p>
      {resto.length > 0 && <div class="intro-more" data-reveal>{resto.map((p) => <p>{p}</p>)}</div>}
      <Rows items={servico.blocos} />
    </div>
  </section>

  {isMarketing && (
    <section class="section" style="padding-top:0">
      <div class="wrap" style="margin-bottom:28px">
        <span class="eyebrow" data-reveal>Portfólio</span>
        <h2 data-reveal>Trabalhos da Making</h2>
      </div>
      <Marquee />
      <div class="wrap"><div class="actions" data-reveal><a class="btn btn--ghost" href="/nossos-servicos/marketing-digital/portfolio/">Ver portfólio completo</a></div></div>
    </section>
  )}

  <Faq items={servico.faq} title={`Perguntas frequentes sobre ${servico.name.toLowerCase()}`} />

  <section class="section">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Continue explorando</span>
      <h2 data-reveal>Outros serviços de {area.name.toLowerCase()}</h2>
      <Rows as="h3" items={outros.map((s) => ({ title: s.name, text: s.resumo, href: `${areaPath}${s.slug}/` }))} />
    </div>
  </section>
  <Cta button={servico.cta} message={`Olá! Vim pelo site e quero saber mais sobre ${servico.name}.`} />
</Base>
