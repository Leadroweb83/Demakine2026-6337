---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Cta from '../../../components/Cta.astro';
import Faq from '../../../components/Faq.astro';
import { areas } from '../../../data/servicos';
import { site } from '../../../data/site';
export function getStaticPaths() {
  return areas.flatMap((area) => area.servicos.map((servico) => ({ params: { area: area.slug, servico: servico.slug }, props: { area, servico } })));
}
const { area, servico } = Astro.props;
const areaPath = `/nossos-servicos/${area.slug}/`;
const path = `${areaPath}${servico.slug}/`;
const crumbs = [
  { name: 'Serviços', href: '/nossos-servicos/' },
  { name: area.name, href: areaPath },
  { name: servico.name, href: path },
];
const schema = [
  {
    '@type': 'Service',
    '@id': `${site.url}${path}#service`,
    name: servico.name,
    serviceType: servico.name,
    category: area.name,
    description: servico.seoDescription,
    url: `${site.url}${path}`,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'Brasil' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: servico.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const outros = area.servicos.filter((s) => s.slug !== servico.slug);
---
<Base title={servico.seoTitle} description={servico.seoDescription} path={path} crumbs={crumbs} schema={schema}>
  <PageHero eyebrow={area.name} title={servico.h1} crumbs={crumbs} lead={servico.intro[0]}>
    <div class="actions"><a class="btn btn--primary" href="/orcamento/">{servico.cta}</a></div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      {servico.intro.slice(1).map((p) => <p class="lead">{p}</p>)}
      <ul class={`grid ${servico.blocos.length > 1 ? 'grid--2' : ''}`} style="margin-top:28px">
        {servico.blocos.map((b) => (
          <li>
            <div class="card">
              <h2 style="font-size:1.3rem">{b.title}</h2>
              {b.text && <p>{b.text}</p>}
              {b.items && <ul class="checks">{b.items.map((i) => <li>{i}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={servico.faq} title={`Perguntas frequentes sobre ${servico.name.toLowerCase()}`} />

  <section class="section">
    <div class="wrap">
      <h2>Outros serviços de {area.name.toLowerCase()}</h2>
      <ul class="grid grid--4" style="margin-top:24px">
        {outros.map((s) => <li><a class="card" href={`${areaPath}${s.slug}/`}><h3>{s.name}</h3><span class="more">Saiba mais →</span></a></li>)}
      </ul>
    </div>
  </section>
  <Cta button={servico.cta} message={`Olá! Vim pelo site e quero saber mais sobre ${servico.name}.`} />
</Base>
