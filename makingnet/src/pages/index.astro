---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import ServiceShowcaseHero from '@/components/ui/service-showcase-hero';
import EarthHero from '@/components/ui/earth-hero';
import IntroVideo from '../components/IntroVideo.astro';
import PartnerSection from '../components/PartnerSection.astro';
import { chamadasHero } from '../data/chamadas';
import PerspectiveTunnelHero from '@/components/ui/perspective-tunnel-hero';
import { site, yearsInBusiness, whatsappLink } from '../data/site';
import { areas, sistemas } from '../data/servicos';
import clientes from '../data/clientes.json';
import portfolio from '../data/portfolio.json';
import PostCard from '../components/PostCard.astro';
import VerticalMarquee from '@/components/ui/marquee-03';
import depoimentos from '../data/depoimentos.json';
import { posts } from '../lib/blog';

const title = "Making: Marketing Digital, TI e Sistemas em Santa Bárbara d'Oeste";
const description = `Agência Google Partner com ${yearsInBusiness} anos de mercado. Criação de sites, SEO, Google Ads, suporte de TI, redes, servidores e o sistema de gestão Velosys.`;

const faq = [
  {
    q: 'O que a Making faz?',
    a: 'A Making atua em três frentes: marketing digital (criação de sites, SEO, Google Ads, anúncios em redes sociais e inbound marketing), hardware e infraestrutura de TI (suporte, redes, servidores, virtualização e venda de equipamentos) e sistemas, com o Velosys, sistema de gestão próprio.',
  },
  {
    q: 'Onde fica a Making?',
    a: `A sede fica na ${site.address.street}, ${site.address.district}, em ${site.address.city}/${site.address.state}. A equipe atende clientes de todos os portes e segmentos em todo o Brasil.`,
  },
  {
    q: 'Há quanto tempo a Making está no mercado?',
    a: `Desde julho de ${site.foundingYear}. São ${yearsInBusiness} anos atuando com tecnologia da informação e comunicação focada na web.`,
  },
  {
    q: 'A Making é uma agência certificada?',
    a: 'Sim. A Making é agência certificada Google Partner e parceira Tray Commerce.',
  },
];
const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const [mkt, infra] = areas;
const variants = [
  {
    name: 'Marketing',
    word: 'Marketing',
    tint: '#20c4f4',
    src: portfolio[0].img,
    alt: `Site ${portfolio[0].name}, criado pela Making`,
    href: `/nossos-servicos/${mkt.slug}/`,
    description: mkt.resumo,
    services: mkt.servicos.map((s) => ({ name: s.name, href: `/nossos-servicos/${mkt.slug}/${s.slug}/` })),
  },
  {
    name: 'TI e Infra',
    word: 'Infra',
    tint: '#7c8cff',
    src: '/img/tema/servidores.webp',
    alt: 'Rack de servidores com cabeamento estruturado',
    href: `/nossos-servicos/${infra.slug}/`,
    description: infra.resumo,
    services: infra.servicos.map((s) => ({ name: s.name, href: `/nossos-servicos/${infra.slug}/${s.slug}/` })),
  },
  {
    name: 'Sistemas',
    word: 'Velosys',
    tint: '#3ee0b0',
    src: sistemas.telas[0].img,
    alt: sistemas.telas[0].alt,
    href: '/nossos-servicos/sistemas/',
    description: sistemas.resumo,
    services: ['Vendas e CRM', 'Estoque e PCP', 'Financeiro e fiscal', 'BI e app mobile'].map((name) => ({ name, href: '/nossos-servicos/sistemas/' })),
  },
];
const tunnel = portfolio.slice(0, 10).map((p) => ({ src: p.img, title: p.name, kind: p.kind, alt: `${p.kind} ${p.name}, desenvolvido pela Making` }));
---

<Base title={title} description={description} path="/" schema={schema}>
  <IntroVideo />

  <EarthHero
    client:load
    heading={`Making · Marketing digital, TI e sistemas desde ${site.foundingYear}`}
    items={chamadasHero}
    astronaut="/img/tema/astronauta-making.webp"
    textureUrl="/img/tema/terra-textura.jpg"
  />

  <ServiceShowcaseHero
    client:visible
    as="h2"
    first={false}
    variants={variants}
    eyebrow="Três frentes, um parceiro"
    description="A Making usa a internet como principal fonte de aquisição de clientes para o seu negócio e cuida da tecnologia que mantém sua empresa funcionando."
    primary={{ label: 'Pedir orçamento', href: '/orcamento/' }}
    secondary={{ label: 'Falar no WhatsApp', href: whatsappLink() }}
  >
    <Fragment slot="title">Ideias em <em>resultados extraordinários</em></Fragment>
  </ServiceShowcaseHero>

  <section class="strip" aria-label="A Making em números">
    <ul class="wrap">
      <li data-reveal><strong>{yearsInBusiness}</strong><span>anos de mercado</span></li>
      <li data-reveal><strong>{portfolio.length}+</strong><span>sites, blogs e lojas no portfólio</span></li>
      <li data-reveal><strong>3</strong><span>frentes: marketing, TI e sistemas</span></li>
      <li data-reveal><strong>Google</strong><span>Partner, agência certificada</span></li>
    </ul>
  </section>

  <section class="section manifesto">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Missão</span>
      <p class="statement" data-reveal>
        Impulsionar o crescimento e a eficiência de nossos clientes, com soluções que usam a internet como <em>principal fonte de aquisição de clientes</em>.
      </p>
      <div class="manifesto__foot">
        <p data-reveal>Atuamos com tecnologia da informação e comunicação desde {site.foundingYear}. Do pequeno empreendedor à grande corporação, atendemos clientes de todos os portes e segmentos em todo o Brasil.</p>
        <a class="btn btn--ghost" href="/sobre/" data-reveal>Conhecer a Making</a>
      </div>
    </div>
  </section>

  <PartnerSection />

  <PerspectiveTunnelHero
    client:visible
    items={tunnel}
    eyebrow="Portfólio"
    text="Sites, blogs e lojas virtuais que unem tecnologia, design e técnicas de SEO."
    cta={{ label: 'Ver portfólio completo', href: '/nossos-servicos/marketing-digital/portfolio/' }}
  >
    <Fragment slot="title">Nossos últimos<br />lançamentos</Fragment>
  </PerspectiveTunnelHero>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Clientes</span>
      <h2 data-reveal>Empresas que confiam<br />no nosso trabalho</h2>
      <ul class="logos logos--mono">
        {clientes.map((c) => <li data-reveal><img src={c.img} alt={`Logo ${c.name}, cliente da Making`} width={c.w} height={c.h} loading="lazy" decoding="async" /></li>)}
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Depoimentos</span>
      <h2 data-reveal>O que dizem os clientes</h2>
      <p class="lead" data-reveal>Avaliações de 5 estrelas publicadas por clientes no perfil da Making no Google.</p>
      <div data-reveal style="margin-top:clamp(24px,4vw,40px)">
        <VerticalMarquee reviews={depoimentos.itens} source={depoimentos.fonte} />
      </div>
      <div class="actions" data-reveal><a class="btn btn--ghost" href={depoimentos.url} target="_blank" rel="noopener">Ver avaliações no Google</a></div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Blog</span>
      <h2 data-reveal>Ideias para vender mais</h2>
      <div class="post-grid" style="margin-top:clamp(28px,4vw,48px)">{posts.slice(0, 3).map((p) => <PostCard post={p} as="h3" />)}</div>
      <div class="actions" data-reveal><a class="btn btn--ghost" href="/blog/">Ver todos os artigos</a></div>
    </div>
  </section>

  <Faq items={faq} title="Perguntas frequentes" />
  <Cta />
</Base>
