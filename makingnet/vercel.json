{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "regions": ["gru1"],
  "trailingSlash": true,
  "redirects": [
    { "source": "/portifolio/", "destination": "/nossos-servicos/marketing-digital/portfolio/", "permanent": true },
    { "source": "/servicos-2/:path*", "destination": "/nossos-servicos/:path*", "permanent": true },
    { "source": "/contato/", "destination": "/fale-conosco/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(img|_astro)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
