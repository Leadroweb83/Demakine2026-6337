{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun vite/optimize-images.ts && vite build && vite build --ssr src/web/entry-server.tsx --outDir dist-ssr && bun vite/prerender.ts && bun build src/api/index.ts --outdir server-build --target node --format esm --packages external",
  "outputDirectory": "dist",
  "regions": [
    "gru1"
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/produtos/esteira-transportadora-em-v",
      "destination": "/produtos/esteira-transportadora-para-granel",
      "permanent": true
    },
    {
      "source": "/produto/esteira-transportadora-em-v",
      "destination": "/produtos/esteira-transportadora-para-granel",
      "permanent": true
    },
    {
      "source": "/produto/:slug",
      "destination": "/produtos/:slug",
      "permanent": true
    },
    {
      "source": "/:lang(en|es)/produto/:slug",
      "destination": "/:lang/produtos/:slug",
      "permanent": true
    },
    {
      "source": "/categoria-produto/:cat(esteiras-transportadoras|linha-transporte)",
      "destination": "/esteiras-transportadoras",
      "permanent": true
    },
    {
      "source": "/categoria-produto/roscas-transportadoras",
      "destination": "/roscas-transportadoras",
      "permanent": true
    },
    {
      "source": "/categoria-produto/elevadores",
      "destination": "/elevadores",
      "permanent": true
    },
    {
      "source": "/categoria-produto/maquinas-para-costurar-sacos",
      "destination": "/maquinas-de-costurar-sacos",
      "permanent": true
    },
    {
      "source": "/categoria-produto/peneira-para-carvao",
      "destination": "/produtos/peneira-para-carvao",
      "permanent": true
    },
    {
      "source": "/categoria-produto/linha-beneficiamento",
      "destination": "/agro",
      "permanent": true
    },
    {
      "source": "/categoria-produto/pecas-para-esteiras-transportadoras",
      "destination": "/assistencia-tecnica",
      "permanent": true
    },
    {
      "source": "/categoria-produto/:slug*",
      "destination": "/produtos",
      "permanent": true
    },
    {
      "source": "/catalogo",
      "destination": "/downloads",
      "permanent": true
    },
    {
      "source": "/:old(esteira-transportadora|esteirastransportadoras|esteira-transportadora-de-correia|esteira-para-transporte|esteira-de-transporte|linha-transporte)",
      "destination": "/esteiras-transportadoras",
      "permanent": true
    },
    {
      "source": "/:old(fabricante-de-esteiras-transportadoras|fabrica-de-esteiras-transportadoras)",
      "destination": "/fabricante-de-esteira-transportadora",
      "permanent": true
    },
    {
      "source": "/:old(esteira-industrial|esteira-de-industria|esteiras-industriais|esteira-automatizada)",
      "destination": "/esteira-transportadora-industrial",
      "permanent": true
    },
    {
      "source": "/:old(esteira-de-roletes-livres|transportador-de-roletes|transportador-de-roletes-livres|esteira-de-roletes|esteira-de-rolos)",
      "destination": "/produtos/esteira-de-roletes-livres",
      "permanent": true
    },
    {
      "source": "/:old(empacotamento-costura|empacotamento-e-costura)",
      "destination": "/maquinas-de-costurar-sacos",
      "permanent": true
    },
    {
      "source": "/produtos",
      "destination": "/esteiras-transportadoras",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "cat",
          "value": "esteiras-transportadoras"
        }
      ]
    },
    {
      "source": "/produtos",
      "destination": "/roscas-transportadoras",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "cat",
          "value": "roscas-transportadoras"
        }
      ]
    },
    {
      "source": "/produtos",
      "destination": "/elevadores",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "cat",
          "value": "elevadores"
        }
      ]
    },
    {
      "source": "/produtos",
      "destination": "/maquinas-de-costurar-sacos",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "cat",
          "value": "empacotamento-e-costura"
        }
      ]
    },
    {
      "source": "/:lang(en|es)/:slug(esteiras-transportadoras|roscas-transportadoras|elevadores|maquinas-de-costurar-sacos|fabricante-de-esteira-transportadora|esteira-transportadora-industrial|esteira-para-carga-e-descarga-de-caminhao|esteira-transportadora-preco|rosca-transportadora-preco|maquina-de-costurar-sacos-preco)",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/:old(beneficiamento-e-classificacao|lavador-de-frutas-e-legumes|lavador-de-batata-doce|polidor-de-frutas-e-legumes)",
      "destination": "/projetos-especiais",
      "permanent": true
    },
    {
      "source": "/produtos-e-servicos/beneficiamento-e-classificacao",
      "destination": "/projetos-especiais",
      "permanent": true
    },
    {
      "source": "/trabalhe-conosco",
      "destination": "/vagas",
      "permanent": true
    },
    {
      "source": "/esteira-logistica",
      "destination": "/segmentos/logistica-e-distribuicao",
      "permanent": true
    },
    {
      "source": "/peneira-de-carvao-3",
      "destination": "/produtos/peneira-para-carvao",
      "permanent": true
    },
    {
      "source": "/:old(correia-transportadora-tipo-piramide|estareia-principal-para-sacaria)",
      "destination": "/produtos/esteira-transportadora-para-sacaria",
      "permanent": true
    },
    {
      "source": "/esteira-transp-com-bica-de-saida-para-materiais-a-granel",
      "destination": "/produtos/esteira-transportadora-para-granel",
      "permanent": true
    },
    {
      "source": "/esteiras-transportadoras/esteira-horizontal-22",
      "destination": "/produtos/esteira-transportadora-horizontal",
      "permanent": true
    },
    {
      "source": "/demakine.com.br/esteira-transportadora-de-caixas-e-pacotes",
      "destination": "/produtos/esteira-transportadora-de-caixas",
      "permanent": true
    },
    {
      "source": "/grimmway-malaga",
      "destination": "/clientes",
      "permanent": true
    },
    {
      "source": "/maquina-de-laranja-paint",
      "destination": "/projetos-especiais",
      "permanent": true
    },
    {
      "source": "/:old(maq-cebola|fabrica-esteiras-transportadoras|fabricante-de-esteiras-transportadoras-)",
      "destination": "/produtos",
      "permanent": true
    },
    {
      "source": "/showrural-2026",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/trabalhe-conosco/:slug",
      "destination": "/vagas",
      "permanent": true
    },
    {
      "source": "/a-empresa/:slug",
      "destination": "/a-empresa",
      "permanent": true
    },
    {
      "source": "/gallery/:path*",
      "destination": "/clientes",
      "permanent": true
    },
    {
      "source": "/gallery-category/:path*",
      "destination": "/clientes",
      "permanent": true
    },
    {
      "source": "/home/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demakine-2/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contato-2/:path*",
      "destination": "/contato",
      "permanent": true
    },
    {
      "source": "/:banner(banner-[a-z0-9-]+)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nossos-produtos/:path*",
      "destination": "/produtos",
      "permanent": true
    },
    {
      "source": "/produtos-e-servicos/:slug",
      "destination": "/produtos",
      "permanent": true
    },
    {
      "source": "/linha-transporte/:slug",
      "destination": "/produtos",
      "permanent": true
    },
    {
      "source": "/blog/demakine-marcou-presenca-na-agrishow-2024/:att*",
      "destination": "/blog/demakine-na-agrishow-2024",
      "permanent": true
    },
    {
      "source": "/blog/batatec-2024-demakine-marcou-presenca-de-sucesso/:att*",
      "destination": "/blog/demakine-na-5a-edicao-da-batatec",
      "permanent": true
    },
    {
      "source": "/:lang(en|es)/blog/demakine-marcou-presenca-na-agrishow-2024/:att*",
      "destination": "/:lang/blog/demakine-na-agrishow-2024",
      "permanent": true
    },
    {
      "source": "/:lang(en|es)/blog/batatec-2024-demakine-marcou-presenca-de-sucesso/:att*",
      "destination": "/:lang/blog/demakine-na-5a-edicao-da-batatec",
      "permanent": true
    },
    {
      "source": "/blog/demakine-marcou-presenca-de-sucesso-na-batatec-2024",
      "destination": "/blog/demakine-na-5a-edicao-da-batatec",
      "permanent": true
    },
    {
      "source": "/blog/guia-completo-sobre-esteira",
      "destination": "/blog/guia-completo-sobre-esteiras-transportadoras",
      "permanent": true
    },
    {
      "source": "/blog/roscas-transportadoras",
      "destination": "/blog/guia-completo-sobre-roscas-transportadoras",
      "permanent": true
    },
    {
      "source": "/blog/:slug(capa-artigo-blog-1|capa-artigo-blog-guia-completo-esteira|batatec-blog)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug(quanto-custa-movimentar-carga-na-mao|como-dimensionar-sua-esteira-transportadora|guia-completo-sobre-esteiras-transportadoras|guia-completo-sobre-roscas-transportadoras|como-escolher-a-esteira-transportadora-ideal-para-a-sua-empresa|10-dicas-para-manutencao-preventiva-de-esteiras-transportadoras|demakine-na-agrobrasilia-2026|demakine-na-agrishow-2026|demakine-na-agrishow-2025|demakine-na-agrishow-2024|demakine-na-5a-edicao-da-batatec)/:att+",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog/:slug/:att+",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/:lang(en|es)/vagas",
      "destination": "/vagas",
      "permanent": false
    },
    {
      "source": "/:lang(en|es)/vagas/:slug",
      "destination": "/vagas/:slug",
      "permanent": false
    },
    {
      "source": "/:lang(en|es)/:rest(loja|admin)",
      "destination": "/:rest",
      "permanent": false
    },
    {
      "source": "/es/export",
      "destination": "/es/exportacion",
      "permanent": true
    },
    {
      "source": "/en/exportacion",
      "destination": "/en/export",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api?__path=sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/admin",
      "destination": "/_app"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/_app"
    },
    {
      "source": "/loja",
      "destination": "/_app"
    },
    {
      "source": "/loja/(.*)",
      "destination": "/_app"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/diario",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/seo",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://*.mailbiz.com.br https://d3eq1zq78ux3cv.cloudfront.net https://cdn.jsdelivr.net/npm/@mailbiz/ https://tagmanager.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.googletagmanager.com https://tagmanager.google.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://dxyxft75r9rwr.cloudfront.net https://d3eq1zq78ux3cv.cloudfront.net https://*.googlesyndication.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://www.googleadservices.com https://*.supabase.co https://*.mailbiz.com.br https://mbiz.mailclick.me https://news.mailclick.me https://integration-hub.mailclick.me https://cdn.jsdelivr.net https://*.google.com https://*.google.com.br https://*.google.com.ar https://*.google.com.py https://*.google.com.uy https://*.google.cl https://*.google.com.co https://*.google.com.pe https://*.google.com.mx https://*.google.es https://*.google.pt https://collector.mailbiz.one; media-src 'self' blob:; frame-src https://integration-hub.mailclick.me https://www.youtube-nocookie.com https://www.youtube.com https://www.google.com https://td.doubleclick.net https://*.googletagmanager.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/_app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
