{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun vite/optimize-images.ts && vite build && vite build --ssr src/web/entry-server.tsx --outDir dist-ssr && bun vite/prerender.ts && bun build src/api/index.ts --outdir server-build --target node --format esm --packages external",
  "outputDirectory": "dist",
  "regions": [
    "gru1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/produtos/esteira-transportadora-em-v",
      "destination": "/produtos/esteira-transportadora-para-granel",
      "permanent": true
    },
    {
      "source": "/trabalhe-conosco",
      "destination": "/vagas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api?__path=sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/admin",
      "destination": "/_app"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/_app"
    },
    {
      "source": "/loja",
      "destination": "/_app"
    },
    {
      "source": "/loja/(.*)",
      "destination": "/_app"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/diario",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
